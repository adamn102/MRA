# Response headers for the MRA portal.
# Read by Cloudflare Pages and by Netlify (identical syntax). A plain static server
# (nginx, Apache) needs the same rules translated into its own config; see HOSTING.md.
#
# These enforce, at the host, the same policy the dev server (scripts/serve_dev.py)
# enforces locally: no off-origin anything, so the "nothing a user pastes leaves the
# machine" guarantee holds in production. If you change a rule here, change it there too.

/*
  # No script, style, image, connection, worker, or form target may be off-origin.
  # A single CDN tag or analytics beacon would break the privacy guarantee; this makes
  # such a reference fail loudly instead of working silently.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; form-action 'none'; base-uri 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Immutable release directories: the model outputs are never overwritten, so cache hard.
/data/v*/*
  Cache-Control: public, max-age=31536000, immutable

# Curated annotation overlays are the exception: they live under a version directory but are
# revised as the literature accrues (new antibodies, corrected DRM calls), so they must NOT be
# frozen. no-cache keeps a stored copy but forces revalidation, so an edit appears on the next
# load instead of being pinned for a year by the immutable rule above. These more-specific
# paths override the /data/v*/* rule. Keep this list in step with MUTABLE_OVERLAYS in sw.js.
/data/v*/bnab_catalog.csv
  Cache-Control: no-cache
/data/v*/drm_catalog.csv
  Cache-Control: no-cache

# The release index and all code/pages change on deploy: never serve a stale copy.
/data/releases.json
  Cache-Control: no-cache
